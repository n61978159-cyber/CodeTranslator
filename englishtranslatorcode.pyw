import tkinter as tk
from tkinter import ttk, messagebox

def get_file_extension(language):
    extensions = {
        'python': 'py',
        'javascript': 'js',
        'js': 'js',
        'c++': 'cpp',
        'cpp': 'cpp',
        'c': 'c',
        'java': 'java',
        'c#': 'cs',
        'csharp': 'cs',
        'ruby': 'rb',
        'php': 'php',
        'swift': 'swift',
        'kotlin': 'kt',
        'html': 'html',
        'css': 'css',
        'sql': 'sql',
        'go': 'go',
        'rust': 'rs'
    }
    return extensions.get(language.lower().strip(), 'txt')

def generate_code():
    language = lang_combo.get().strip()
    commands_text = text_input.get("1.0", tk.END).strip()
    
    if not language:
        messagebox.showerror("Error", "Please select or enter a programming language!")
        return
        
    if not commands_text:
        messagebox.showerror("Error", "Please enter at least one command!")
        return

    lines = commands_text.split('\n')
    ext = get_file_extension(language)
    filename = f"generated_code.{ext}"
    
    code_content = []
    code_content.append(f"// Generated by englishtranslatorcode")
    code_content.append(f"// Target language: {language}\n")
    
    for item in lines:
        if not item.strip():
            continue
        if ext == 'py':
            code_content.append(f"# {item}")
        elif ext in ['js', 'cpp', 'c', 'java', 'cs', 'php', 'swift', 'kt', 'go', 'rs']:
            code_content.append(f"// {item}")
        elif ext == 'sql':
            code_content.append(f"-- {item}")
        else:
            code_content.append(f"{item}")

    try:
        with open(filename, 'w', encoding='utf-8') as f:
            f.write("\n".join(code_content))
        messagebox.showinfo("Success", f"File successfully created and saved as:\n{filename}")
    except Exception as e:
        messagebox.showerror("Error", f"Failed to save file: {e}")

# Creating the graphical window
root = tk.Tk()
root.title("English Code Translator")
root.geometry("500x450")
root.minsize(400, 350)

# UI Elements
tk.Label(root, text="Select or enter programming language:", font=("Arial", 10)).pack(pady=5)

languages_list = ['python', 'javascript', 'c++', 'java', 'c#', 'html', 'css', 'sql', 'go', 'rust']
lang_combo = ttk.Combobox(root, values=languages_list, font=("Arial", 10))
lang_combo.pack(pady=5, fill=tk.X, padx=20)
lang_combo.set('python')

tk.Label(root, text="Enter your commands (each on a new line):", font=("Arial", 10)).pack(pady=5)

text_input = tk.Text(root, font=("Arial", 10), height=12)
text_input.pack(pady=5, fill=tk.BOTH, expand=True, padx=20)

btn_generate = tk.Button(root, text="Generate File", command=generate_code, font=("Arial", 11, "bold"), bg="#2196F3", fg="white")
btn_generate.pack(pady=10)

# Main loop to keep the window open
root.mainloop()